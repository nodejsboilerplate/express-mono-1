    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --verbose",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx ./src/libs/reset.db.ts",
    "test": "vitest",
    "check:types": "tsc --noEmit --listFiles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
