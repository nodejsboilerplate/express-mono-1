    "conventional-changelog-conventionalcommits": "^10.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "inquirer": "^14.1.0",
    "install": "^0.13.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
