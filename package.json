    "dev": "tsx --watch ./src/index.ts",
    "build": "tsdown",
    "format": "prettier --write \"**/*.{ts,md,json,js}\"",
    "gen:docs": "typedoc",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 1000",
